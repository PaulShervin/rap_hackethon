# ============================================================
# AMAZON BEDROCK CONFIGURATION
# ============================================================

# AWS region for Bedrock Runtime
BEDROCK_REGION=us-west-2

# Bedrock model ID
# Cross-region inference profile (us. prefix required for on-demand throughput)
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# AWS credentials — set in your shell/environment, NOT here.
# boto3 reads them automatically from the environment:
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_SESSION_TOKEN   (required for temporary/workshop credentials)
#   AWS_REGION or AWS_DEFAULT_REGION

# ============================================================
# APPLICATION SETTINGS
# ============================================================
MAX_TOOL_CALLS=6
LOG_LEVEL=INFO
PORT=7860
